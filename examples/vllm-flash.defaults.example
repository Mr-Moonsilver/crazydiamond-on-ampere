# /etc/default/vllm-flash: example engine settings for build-6, read by vllm-flash.service and the launcher
# packet/harness/native30_overlay/run-flash-s5-test.sh (installed on the box as run-flash-prod.sh).
#
# This file is NOT a copy of the box file. It was put together for publication from:
#   - packet/harness/runs/q18a_parity_n3s24q2024p_j2_cxfx42_b1_settings.sh (S5_SETTINGS),
#   - the serve changes in packet/serve-launch.sh and packet/serve-params.env,
#   - the effective container settings in packet/vision-container-env.json.
# On the box, serve-launch.sh renders the real file with harness/setcfg.reference.py; prefer that route.
# Format: systemd EnvironmentFile (KEY="value", one per line, no trailing comments).

# Engine overlay directory (the installed copy of packet/harness/native30_overlay).
OVERLAY="/data/vllm/flash-next-tp4/prod/overlay-v16s5-g4-headroom-20261118a"
CORE_OVERLAY="1"
S5="1"
# File with VLLM_API_KEY=<your-key> (see vllm-api.env.example).
FLASH_S5_AUTH_ENV_FILE="/root/.flashnext-serve-<tag>/vllm-api.env"

# Model split: 2 pipeline stages of 24 layers; with GPU order 0,2,1,3 the TP pairs are physical GPUs (0,2) and (1,3).
PP_LAYER_PARTITION="24,24"
GPU_ORDER="0,2,1,3"

# Serving limits: total context per request (prompt + output) and concurrent sequences.
MAX_MODEL_LEN="200000"
MAX_SEQS="8"

# Memory: GPU KV pool bytes per GPU, host (CPU RAM) KV pool GiB per GPU, VRAM row-cache slots per request.
GPU_KV_BYTES="2150000000"
HOST_KV_GIB_PER_RANK="33"
QSA_ROWCACHE_SLOTS="6144"

# Scheduler: stock batching cap per step, PP prefill/decode alternation, scheduler stats every 200 steps.
PREFILL_CHUNK="1024"
FLASH_PD_ALTERNATE="1"
FLASH_PARITY_BALANCE="1"
FLASH_SCHED_STATS="200"
PREFIX_CACHING="1"
# MTP / speculative decoding is off in this release.
MTP_TOKENS="0"

# Images: the engine accepts only precomputed image embeddings from the trusted gateway.
VISION="1"
VISION_ARGS="--enable-mm-embeds --limit-mm-per-prompt {\"image\":0,\"video\":0} --mm-processor-cache-gb 0 --skip-mm-profiling"

# Extra vLLM arguments (prefix match inside a block, cached-token counts in the API usage).
EXTRA_ARGS="--prefix-match-unit 176 --enable-prompt-tokens-details"

# Engine switches, passed into the container as environment variables. The two *_SHA256 values are the
# build-6 pins of the compiled helpers; they must equal sha256sum of the libraries you build
# (packet/harness/native30_overlay/e3/native/build_q17_helpers.sh).
EXTRA_ENV="FLASH_S5_JUNCTION_YIELD=1 FLASH_S5_BULK_SHORTEST=1 FLASH_S5_OVERLAP=1 FLASH_S5_DECODE_ONLY_PROBE=0 FLASH_S5_DECODE_SMS=24 FLASH_S5_GREEN_LIB=/usr/local/lib/python3.12/dist-packages/vllm/v1/flash_e3/native/flash_s5_green.so FLASH_S5_GREEN_LIB_SHA256=e06b062263dcc315dec1ab279f1c08abc8f627e4c6f901ef5a740ec307cba41b FLASH_S5_REPLAY_OBSERVER=0 FLASH_S5_ENGINE_OFFERS=0 FLASH_S5_AUTO_ARM=1 FLASH_S5_NATIVE_PROGRESS=burst FLASH_S5_NATIVE_QSA_POLICY=dense FLASH_S5_QSA_FUSED=1 FLASH_S5_LAYER_GROUPS=1 FLASH_S5_STAGE_LOCAL=1 FLASH_S5_HANDLER_ANATOMY=1 FLASH_S5_STAGE_OVERLAP=1 FLASH_S5_STAGE_OVERLAP_DEFER_BIND=1 FLASH_S5_STAGE_OVERLAP_OBSERVE=1 FLASH_S5_LAZY_RECV=1 FLASH_S5_DECODE_MERGE=1 FLASH_ATTN_META_GDN_BATCH=1 FLASH_S5_INWAIT=1 FLASH_S5_APPEND_YIELD_MAX_NEW=8192 FLASH_S5_APPEND_YIELD_PER_BULK=8 FLASH_S5_APPEND_YIELD_HANDBACK_STEPS=16 FLASH_S5_APPEND_YIELD_REENTRY_RETRIES=4 CUDA_DEVICE_MAX_CONNECTIONS=32 FLASH_S5_PLE_PRIVATE=1 FLASH_S5_PLE_WITNESS=1 FLASH_S5_CHUNK_TOKENS=2048 FLASH_S5_PREPARE_AHEAD=1 VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=64 FLASH_S5_O3=1 FLASH_S5_AHEAD_NOSYNC=1 FLASH_S5_FUSED_PHASE_EVERY=16 FLASH_S5_NEXT_LAYER_PREFETCH=1 FLASH_S5_SMALL_PIECE_BATCH=0 FLASH_S5_YIELD_REENTRY_SETTLE=0 FLASH_S5_YIELD_NO_APPEND_OWNER=1 FLASH_S5_YIELD_WINDOW=1 FLASH_S5_INGRESS_INCREMENTAL=0 FLASH_S5_APPEND_NO_BLOCK_STOP=1 FLASH_S5_DECODE_GROUPS=chunk FLASH_S5_DECODE_LIVENESS=0 FLASH_S5_CONTROL_INWAIT=0 FLASH_S5_CONTROL_O3_INWAIT=0 FLASH_S5_DECODE_SAMPLE_FAST=0 FLASH_S5_DECODE_ANATOMY=1 FLASH_S5_DECODE_TIMELINE=1 FLASH_S5_DECODE_OVERLAP_SMS=42 FLASH_S5_YIELD_WINDOW_FIX=1 FLASH_S5_REPLAY_LIB=/usr/local/lib/python3.12/dist-packages/vllm/v1/flash_e3/native/flash_s5_replay_observer.so FLASH_S5_REPLAY_LIB_SHA256=05a4846d17699a692e923882fcf6c7e8eb4cf486f1888823ac1e4072695ac06d Q18A_TARGET_LABEL=s5-overlap-80-80 FLASH_NATIVE30_LOCALIZE=0 FLASH_NATIVE33_DIAG=0 FLASH_NATIVE34_DIAG=0 FLASH_NATIVE30_SYNC=none PYTHONPATH=/usr/local/lib/python3.12/dist-packages/vllm/v1/flash_e3/native30_plugins FLASH_S5_NATIVE_MM=1 FLASH_S5_G4_HEADROOM=1"
