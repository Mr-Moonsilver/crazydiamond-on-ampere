# Engine API key file. Real file: /root/.flashnext-serve-<tag>/vllm-api.env, owner root, mode 0600.
# The launcher passes it to Docker with --env-file (never on argv) and refuses a key that is not 64 characters.
# packet/serve-mint-key.sh shows how build-6 minted one: 32 random bytes as lowercase hex.
VLLM_API_KEY=<your-key>
