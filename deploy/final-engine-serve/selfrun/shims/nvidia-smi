#!/usr/bin/env python3
"""self-run shim: 4 GPUs of 24576 MiB; used = 0 idle, the arm's scenario values while the container runs, or $SR/gpu-override."""
import json, os, sys
SR = os.environ['SR']
used = [0, 0, 0, 0]
p = os.path.join(SR, 'docker', 'qwen-flash-prod.json')
if os.path.exists(p):
    s = json.load(open(p))
    try:
        os.kill(s['State']['Pid'], 0)
        engine = any(e == 'FLASH_S5_OVERLAP=1' for e in s['Config']['Env'])
        used = [22850, 22740, 22960, 22850] if engine else [22700, 22650, 22800, 22700]
    except OSError:
        pass
o = os.path.join(SR, 'gpu-override')
if os.path.exists(o) and open(o).read().strip():
    used = [int(x) for x in open(o).read().split(',')]
q = [x for x in sys.argv if x.startswith('--query-gpu=')][0].split('=', 1)[1]
for i, u in enumerate(used):
    print(', '.join(str(dict(index=i, **{'memory.used': u, 'memory.total': 24576})[k]) for k in q.split(',')))
