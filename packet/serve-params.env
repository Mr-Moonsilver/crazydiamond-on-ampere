# Final-engine serve: the DECLARED parameters (one file, hashed in PACKET-SHA256SUMS; a change is a new packet sha).
# Written by tools/build_final_engine_serve.py from its arguments; the launch refuses if this file differs from the sums.
SERVE_TAG=vision-prod-w27-20261117a
# --- external parameters, identical on both arms (the A/B contract) ---
MAX_MODEL_LEN=200000
MAX_SEQS=8
# --- row cache: the engine's measured operating point and the deployment-stock value ---
ENGINE_ROWCACHE_SLOTS=6144
STOCK_ROWCACHE_SLOTS=10240
# PENDING_SIZING = no sizing yet; CANDIDATE:<sha16> = the settings-only candidate of Codex's SIZING-final-engine-8x200k note with that
# sha256 prefix (its physical 8 x 200k fit with 40 MiB free is NOT proven); SIZED:<sha16> = a sizing that certifies the fit
PARAMS_STATUS=CANDIDATE:8095a93b096faf84
# --- per-rank VRAM (nvidia-smi physical MiB, keyed by physical GPU index 0..3; rank r = GPU_ORDER[r] = 0,2,1,3) ---
VRAM_FLOOR_MIB=40
VRAM_SAMPLE_S=5
# engine startup budget = cxfx42's measured startup used (w16 b1..b4, identical) + the peer-vram template's 64 MiB/rank
VRAM_ENGINE_REF_MIB=22856,22748,22968,22860
VRAM_NET_LIMIT_MIB=95
# stock has no measured startup reference in the registered records: floor only at startup (its readings are recorded)
VRAM_STOCK_REF_MIB=none
# FLOOR_ACTION: record = latch floor-breach.json + recorder line, the A/B reader marks the arm invalid; drain = also run serve-drain.sh
FLOOR_ACTION=record
# --- pins ---
BUNDLE_SUMS_SHA=3db1828ee0982a02753a5f97afe5f85c23936563b3a93e2847d1817f1335899d
OVERLAY_SUMS_SHA=2abbcef55b4a8a1860511a5f85f72299715f081d41968ca363258264cb43c249
S5_LAUNCHER_SHA=3733ee91ea8cfa994c1a9fbeb2911faad3ad6470307e98975e2a49de464d043e
GREEN_SHA=e06b062263dcc315dec1ab279f1c08abc8f627e4c6f901ef5a740ec307cba41b
OBSERVER_SHA=05a4846d17699a692e923882fcf6c7e8eb4cf486f1888823ac1e4072695ac06d
IMAGE_ID=sha256:ad067db5d64ed30b52f5aa9ae88d7645e71ff1842c876d7db116fed617a5cd0b
FOUND_LAUNCHER_SHA=45cc5d813dca6610dd871b99b095956f307f29ab5f8de4993400018c1ab80c88
